# Gere uma chave local e use a mesma no frontend. Não publique o .env.
API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-4-26b-a4b-it:free
LLM_URL=https://openrouter.ai/api/v1
# Chave criada no OpenRouter. Esta chave fica somente no backend.
OPEN_ROUTER_KEY=
LLM_TIMEOUT=60
CONTEXT_TURNS=8
DATABASE_PATH=data/execucao/prosa.sqlite3

# Para fixar um modelo, copie um identificador :free do catálogo atual.
# Alternativa local sem chave: LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b e LLM_URL=http://localhost:11434
# Outra API: LLM_PROVIDER=openai_compatible, com URL, modelo e chave próprios.
# Para openai_compatible, use LLM_API_KEY para a chave desse outro provedor.
